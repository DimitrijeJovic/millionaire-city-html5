# Dependencies
node_modules/
vendor/_dl/

# Build & Distribution Artifacts
build/
dist/

# Bundled local binaries
tools/runtime/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Game assets: generated locally from the user's own original game files and never committed
# (see CLAUDE_ASSET_POLICY.md). Only the two README files in public/assets/ are tracked.
public/assets/*
!public/assets/README.md
!public/assets/fonts/
public/assets/fonts/*
!public/assets/fonts/README.md

# City data converted from original game files and saves; supplied locally, never committed.
public/data/*
!public/data/README.md

# Test evidence, logs and profiling dumps
docs/evidence/
*.log
*.tmp
*.bak

# Research database copies and personal save snapshots
research/save_copy/
research/lab_ref/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Operating System and Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~
